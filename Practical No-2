def document_decorator(func):
    def wrapper(*args, **kwargs):
        print("=" * 60)
        print("DOCUMENT MANAGEMENT SYSTEM".center(60))
        print("=" * 60)

        func(*args, **kwargs)

        print("=" * 60)
        print("DOCUMENT COMPLETED".center(60))
        print("=" * 60)

    return wrapper


class Document:
    organization = "Global Tech Solutions"

    def __init__(self, title, author):
        self.title = title
        self.author = author
        self.sections = []

    def add_section(self, text):
        self.sections.append(text)

    @classmethod
    def change_organization(cls, name):
        cls.organization = name

    @staticmethod
    def divider():
        print("-" * 60)

    def __str__(self):
        return f"Document : {self.title}\nPrepared By : {self.author}"

    def __len__(self):
        return len(self.sections)

    @document_decorator
    def show_document(self):
        print("Organization :", Document.organization)
        print(self)

        Document.divider()

        print("Document Sections:")

        for i, item in enumerate(self.sections, start=1):
            print(f"{i}. {item}")

        Document.divider()

        print("Total Sections :", len(self))


