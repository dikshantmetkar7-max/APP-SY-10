def knapsack(weights, profits, capacity):

    n = len(weights)

    dp = [[0] * (capacity + 1) for _ in range(n + 1)]

    for i in range(1, n + 1):

        for w in range(capacity + 1):

            if weights[i-1] > w:

                dp[i][w] = dp[i-1][w]

            else:
                dp[i][w] = max(
                    dp[i-1][w],
                    profits[i-1] + dp[i-1][w - weights[i-1]]
                )

    w = capacity

    selected_items = []

    for i in range(n, 0, -1):

        if dp[i][w] != dp[i-1][w]:

            selected_items.append(i-1)

            w -= weights[i-1]

    selected_items.reverse()

    return dp[n][capacity], selected_items


weights = [3, 2, 4, 5, 1]

profits = [50, 40, 70, 80, 10]

capacity = 7

max_profit, items = knapsack(weights, profits, capacity)

print("Maximum Profit:", max_profit)

print("Items in Knapsack:", items)

def solve_knapsack(weight, value, max_capacity):

    total_items = len(weight)

    table = [[0] * (max_capacity + 1) for _ in range(total_items + 1)]

    for item in range(1, total_items + 1):

        for capacity in range(max_capacity + 1):

            if weight[item - 1] <= capacity:

                table[item][capacity] = max(
                    table[item - 1][capacity],
                    value[item - 1] + table[item - 1][capacity - weight[item - 1]]
                )

            else:
                table[item][capacity] = table[item - 1][capacity]

    capacity = max_capacity
    chosen = []

    for item in range(total_items, 0, -1):

        if table[item][capacity] > table[item - 1][capacity]:

            chosen.append(item)
            capacity -= weight[item - 1]

    chosen.reverse()

    return table[total_items][max_capacity], chosen


weight = [3, 2, 4, 5, 1]
value = [50, 40, 70, 80, 10]
max_capacity = 7

profit, selected = solve_knapsack(weight, value, max_capacity)

print("\n========== KNAPSACK RESULT ==========")
print("Bag Capacity       :", max_capacity)
print("Maximum Profit     :", profit)
print("Selected Item Nos. :", selected)
print("=====================================")
