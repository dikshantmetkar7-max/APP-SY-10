def fibonacci_iterative(n):

    # If n is 0
    if n == 0:
        return 0

    # If n is 1
    elif n == 1:
        return 1


    a, b = 0, 1

  
    for _ in range(2, n + 1):

        c = a + b

        a = b

        b = c

    return b

n = int(input("Enter the value of n: "))

result = fibonacci_iterative(n)

print("Fibonacci number is:", result)
def find_fibonacci(position):

    first = 0
    second = 1

    if position == 0:
        return first

    for i in range(1, position):
        next_number = first + second
        first = second
        second = next_number

    return second


num = int(input("Enter the position: "))

if num < 0:
    print("Please enter a non-negative number.")
else:
    answer = find_fibonacci(num)
    print(f"The Fibonacci number at position {num} is: {answer}")
